{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/ai-incident-event.schema.json",
  "title": "AI Incident Event",
  "type": "object",
  "required": ["event_type"],
  "properties": {
    "event_type": {
      "type": "string",
      "enum": [
        "chat_completion",
        "rag_response",
        "tool_call",
        "agent_action",
        "moderation_event",
        "system_error"
      ]
    },
    "input_text": { "type": "string" },
    "output_text": { "type": "string" },
    "system_prompt": { "type": "string" },
    "user_prompt": { "type": "string" },
    "retrieved_context": {
      "type": "array",
      "items": { "type": "object" }
    },
    "tool_calls": {
      "type": "array",
      "items": { "type": "object" }
    },
    "request_id": { "type": "string" },
    "session_id": { "type": "string" },
    "user_id": { "type": "string" },
    "metadata": { "type": "object" }
  },
  "additionalProperties": false
}
